@page "{id}"
@namespace Practica_1_web.Pages.Telefonos
@model EditModel
@{
    ViewData["Title"] = "Editar Teléfono";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Teléfonos</span>
        <h1>Editar teléfono</h1>
        <p>Actualiza los datos del teléfono seleccionado.</p>
    </div>
</div>

<form method="post" class="form-card">
    <input type="hidden" name="telefonoDto.Id" value="@Model.TelefonoDto.Id" />

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group mb-3">
        <label for="numero" class="form-label">Número telefónico</label>
        <input type="text" id="numero" name="telefonoDto.Numero" class="form-control" value="@Model.TelefonoDto.Numero" required />
    </div>

    <div class="form-group mb-3">
        <label for="tipo" class="form-label">Tipo de teléfono</label>
        <input type="text" id="tipo" name="telefonoDto.Tipo" class="form-control" value="@Model.TelefonoDto.Tipo" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="TelefonoDto.ClienteId" class="form-label">Cliente</label>
        <select asp-for="TelefonoDto.ClienteId" asp-items="Model.Clientes" class="form-control" required>
            <option value="">Seleccione un cliente</option>
        </select>
        <span asp-validation-for="TelefonoDto.ClienteId" class="field-validation"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="button button-primary">Guardar cambios</button>
        <a asp-page="Index" class="button button-outline">Cancelar</a>
    </div>
</form>
