@page "{id}"
@namespace Practica_1_web.Pages.Telefonos
@model DeleteModel
@{
    ViewData["Title"] = "Eliminar Teléfono";
}

<h1>Eliminar Teléfono</h1>

<div class="alert alert-warning">
    <p>¿Está seguro de que desea eliminar el teléfono <strong>@Model.TelefonoDto.Numero</strong>?</p>
    <p>Esta acción no se puede deshacer.</p>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a href="/Telefonos" class="btn btn-secondary">Cancelar</a>
</form>
