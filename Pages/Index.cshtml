@page
@namespace Practica_1_web.Pages
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <span class="eyebrow">Panel principal</span>
    <h1>Gestión de clientes y teléfonos</h1>
    <p class="lead">Administra la información de tus clientes y sus números telefónicos desde un solo lugar.</p>
</div>

<div class="dashboard-grid">
    <section class="dashboard-card">
        <div class="card-icon" aria-hidden="true">C</div>
        <h2>Clientes</h2>
        <p>Registra, consulta, edita y elimina clientes.</p>
        <div class="card-actions">
            <a class="button button-primary" asp-page="/Clientes/Index">Ver clientes</a>
            <a class="button button-outline" asp-page="/Clientes/Create">Nuevo cliente</a>
        </div>
    </section>

    <section class="dashboard-card">
        <div class="card-icon card-icon-teal" aria-hidden="true">T</div>
        <h2>Teléfonos</h2>
        <p>Asocia números telefónicos con cada cliente.</p>
        <div class="card-actions">
            <a class="button button-primary" asp-page="/Telefonos/Index">Ver teléfonos</a>
            <a class="button button-outline" asp-page="/Telefonos/Create">Nuevo teléfono</a>
        </div>
    </section>
</div>
